# Copiez ce fichier en .env et remplissez-le. Le fichier .env n'est jamais versionné.

# Base PostgreSQL : postgres://utilisateur:mot-de-passe@hôte:port/base
DATABASE_URL=postgres://site_agent:CHANGEZ-MOI@127.0.0.1:5432/site_agent

# Adresse à laquelle l'équipe ouvre Site Agent (celle de Caddy en production).
SITE_AGENT_PUBLIC_URL=http://127.0.0.1:8000

# Envoi des liens « mot de passe oublié ». Sans EMAIL_HOST, les courriels vont dans le journal.
# EMAIL_HOST=smtp.mon-entreprise.fr
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=Site Agent <site-agent@mon-entreprise.fr>
